{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@legaleasy/shared": ["packages/shared/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.d.ts", "apps/**/*.ts", "apps/**/*.tsx", "apps/**/*.d.ts"]
}
